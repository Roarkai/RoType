#!/bin/bash
set -euo pipefail

script_dir=$(/usr/bin/dirname "$0")
/bin/bash "$script_dir/normalize-input-method.sh"

squirrel_app="/Library/Input Methods/洛克输入法.app"
squirrel_executable="$squirrel_app/Contents/MacOS/Squirrel"
settings_helper="$squirrel_app/Contents/Helpers/洛克输入法设置.app"
translation_service="im.roarkai.inputmethod.Luoke.translation"
translation_agent="/Library/LaunchAgents/$translation_service.plist"
retired_helper_service="im.roarkai.inputmethod.Luoke.helper"
retired_helper_agent="/Library/LaunchAgents/$retired_helper_service.plist"
legacy_helper_service="dev.rotype.voice"
legacy_helper_agent="/Library/LaunchAgents/$legacy_helper_service.plist"
legacy_system_voice_app="/Applications/RoType Voice.app"
legacy_factory_data="/Library/Application Support/RoType/Rime"
backup_root="/Library/Application Support/RoType/Backups"
/bin/mkdir -p "$backup_root"

active_gui_uids() {
  /bin/ps -axo uid=,command= | /usr/bin/awk \
    '$1 >= 500 && $2 == "/System/Library/CoreServices/loginwindow.app/Contents/MacOS/loginwindow" { print $1 }' | \
    /usr/bin/sort -nu
}

user_for_uid() {
  /usr/bin/id -nu "$1" 2>/dev/null || true
}

home_for_user() {
  /usr/bin/dscl . -read "/Users/$1" NFSHomeDirectory 2>/dev/null | \
    /usr/bin/awk 'sub(/^[^:]*:[[:space:]]*/, "") { print; exit }'
}

run_as_user() {
  local uid="$1"
  shift
  local user
  user=$(user_for_uid "$uid")
  [[ -n "$user" ]] || return 1
  /bin/launchctl asuser "$uid" /usr/bin/sudo -Hu "$user" "$@"
}

move_legacy_app() {
  local source="$1"
  local expected_bundle_id="$2"
  local backup_name="$3"
  [[ -d "$source" ]] || return 0
  local bundle_id
  bundle_id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$source/Contents/Info.plist" 2>/dev/null || true)
  [[ "$bundle_id" == "$expected_bundle_id" ]] || return 0
  /bin/mv "$source" "$backup_root/$backup_name-$(/bin/date +%Y%m%d-%H%M%S)-$$.app"
}

if [[ -d "$legacy_system_voice_app" ]]; then
  legacy_bundle_id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$legacy_system_voice_app/Contents/Info.plist" 2>/dev/null || true)
  if [[ "$legacy_bundle_id" == "dev.rotype.voice" ]]; then
    /bin/rm -R "$legacy_system_voice_app"
  fi
fi
/bin/rm -rf "$legacy_factory_data"

# Loaded LaunchAgents are per GUI login domain. Retire old RoType jobs and
# install the on-demand translation job for every currently active user.
translation_agent_failed_uids=""
while IFS= read -r uid; do
  [[ -n "$uid" ]] || continue
  /bin/launchctl bootout "gui/$uid/$legacy_helper_service" >/dev/null 2>&1 || true
  /bin/launchctl bootout "gui/$uid/$retired_helper_service" >/dev/null 2>&1 || true
  /bin/launchctl bootout "gui/$uid/$translation_service" >/dev/null 2>&1 || true

  run_as_user "$uid" "$squirrel_executable" --quit >/dev/null 2>&1 || true
  run_as_user "$uid" "$settings_helper/Contents/MacOS/LuokeInput" --quit >/dev/null 2>&1 || true

  user=$(user_for_uid "$uid")
  if [[ -n "$user" ]]; then
    user_home=$(home_for_user "$user")
    if [[ -n "$user_home" && "$user_home" == /* ]]; then
      move_legacy_app "$user_home/Applications/RoType Voice.app" "dev.rotype.voice" "legacy-voice-$uid"
      move_legacy_app "$user_home/Applications/洛克输入法.app" "dev.rotype.voice" "legacy-named-voice-$uid"
    fi
  fi

  if [[ -x "$squirrel_app/Contents/Helpers/RoTypeTranslationService" ]]; then
    agent_ready=true
    /bin/launchctl enable "gui/$uid/$translation_service" >/dev/null 2>&1 || agent_ready=false
    /bin/launchctl bootstrap "gui/$uid" "$translation_agent" >/dev/null 2>&1 || agent_ready=false
    /bin/launchctl print "gui/$uid/$translation_service" >/dev/null 2>&1 || agent_ready=false
    if ! $agent_ready; then
      translation_agent_failed_uids="$translation_agent_failed_uids $uid"
      echo "RoType: failed to activate translation service for GUI uid $uid." >&2
    fi
  fi
done < <(active_gui_uids)

/bin/rm -f "$legacy_helper_agent" "$retired_helper_agent"

console_user=$(/usr/bin/stat -f '%Su' /dev/console)
if [[ -z "$console_user" || "$console_user" == "root" || "$console_user" == "loginwindow" ]]; then
  echo "RoType: no console user; after login, enable RoType in Keyboard Settings and open its settings from the input menu."
  exit 0
fi
console_uid=$(/usr/bin/id -u "$console_user")
console_home=$(home_for_user "$console_user")
if [[ -z "$console_home" || "$console_home" != /* ]]; then
  echo "RoType: could not resolve the console user's home directory." >&2
  exit 0
fi

source "$script_dir/configure-user.sh"
translation_agent_ready=true
if [[ " $translation_agent_failed_uids " == *" $console_uid "* ]]; then
  translation_agent_ready=false
fi
finish_rotype_user_setup "$console_uid" "$console_home" "$squirrel_executable" "$settings_helper" "$translation_agent_ready"
